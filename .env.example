# Nexu Atelier - Environment Configuration
# Do not store production secrets or live credentials in this file.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MARKETPLACE_NAME="Nexu Atelier & Marketplace"
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Platform Operating Mode (Strict Demo Isolation)
# Set to "true" for Demo, Student, and Hackathon modes (uses sandbox adapters).
# Set to "false" ONLY for secured production deployment with live API credentials.
DEMO_MODE=true

# PostgreSQL Database Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexu_ecommerce?schema=public"

# Cryptographic Audit Ledger Secret (HMAC-SHA256)
# In production, provide a cryptographically random 32+ character secret.
AUDIT_HMAC_SECRET="nexu_dev_audit_secret_change_in_production_32chars"

# Authentication & Session Security
AUTH_COOKIE_NAME=nexu_customer_session
AUTH_SESSION_TTL_DAYS=7

# Phase 6 Payment Gateway (Razorpay Sandbox / Test Mode)
# Set PAYMENT_PROVIDER to "RAZORPAY" when using live sandbox keys; defaults to "SANDBOX"
PAYMENT_PROVIDER=SANDBOX
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Phase 6 3PL Shipping & Logistics (Shiprocket Sandbox)
# Set SHIPPING_PROVIDER to "SHIPROCKET" when configured; defaults to "SIMULATED_3PL"
SHIPPING_PROVIDER=SIMULATED_3PL
SHIPROCKET_EMAIL=logistics@nexu.studio
SHIPROCKET_PASSWORD=placeholder_password
SHIPROCKET_WEBHOOK_TOKEN=placeholder_token
SHIPPING_WEBHOOK_SECRET=simulated_shipping_secret_2026

# Phase 6 Transactional Notifications (Outbox Engine)
NOTIFICATION_PROVIDER=CONSOLE
EMAIL_FROM="NEXU ATELIER <concierge@nexuatelier.com>"
ADMIN_NOTIFICATION_EMAIL="admin@nexuatelier.com"
RESEND_API_KEY=re_placeholder_api_key

# Phase 6 WhatsApp OTP & Verification (Official Meta Cloud API)
# Primary OTP channel for registration, login, phone verification & password reset.
# (Note: SMS has been completely deprecated and removed in favor of WhatsApp).
WHATSAPP_API_TOKEN=placeholder_meta_system_user_token
WHATSAPP_PHONE_NUMBER_ID=placeholder_meta_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=placeholder_waba_id
WHATSAPP_API_VERSION=v20.0
WHATSAPP_OTP_TEMPLATE_NAME=nexu_auth_code
WHATSAPP_OTP_TEMPLATE_LANG=en_US
